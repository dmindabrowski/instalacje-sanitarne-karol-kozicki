---
import firma from '../data/firma.json';
import { telHref } from '../lib/tekst';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = firma.opis } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The preview on GitHub Pages lives in a subfolder, the final site at the root of its domain; `base` covers both.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The preview shows sample data, so search engines are asked to stay away from it.
const podglad = Astro.site?.hostname.endsWith('github.io');

const menu = [
	{ href: `${base}/#zakres`, nazwa: 'Zakres' },
	{ href: `${base}/#wspolpraca`, nazwa: 'Współpraca' },
	{ href: `${base}/#realizacje`, nazwa: 'Realizacje' },
	{ href: `${base}/#kontakt`, nazwa: 'Kontakt' },
];

const schema = {
	'@context': 'https://schema.org',
	'@type': 'HomeAndConstructionBusiness',
	name: firma.nazwaPelna,
	url: new URL(`${base}/`, Astro.site),
	email: firma.email,
	...(firma.telefon && { telephone: firma.telefon }),
	description: firma.opis,
	foundingDate: String(firma.odRoku),
	taxID: firma.nip,
	address: {
		'@type': 'PostalAddress',
		streetAddress: firma.adres.ulica,
		postalCode: firma.adres.kod,
		addressLocality: firma.adres.miasto,
		addressCountry: 'PL',
	},
};
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{podglad && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#ffffff" />
		<script is:inline>
			// Light is the default. Dark is applied only when the visitor chose it here before, and before the first paint, so the page does not flash.
			try {
				if (localStorage.getItem('motyw') === 'ciemny') {
					document.documentElement.dataset.theme = 'dark';
					document.querySelector('meta[name="theme-color"]').content = '#0c0c0d';
				}
			} catch {}

			// Entry animations (the drawing draws itself, the cooperation axis unrolls) need the starting state hidden before the first paint.
			// The class is set only when they will really play; if the script at the end of the page never runs, it is taken back.
			if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('anim');
				setTimeout(() => window.revealReady || document.documentElement.classList.remove('anim'), 4000);
			}
		</script>

		<link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
		<link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
		<link rel="preload" href={`${base}/fonts/ibm-plex-sans-latin-wght-normal.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={`${base}/fonts/ibm-plex-sans-latin-ext-wght-normal.woff2`} as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:site_name" content={firma.nazwaPelna} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(`${base}/og.png`, Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body>
		<a class="skip-link" href="#tresc">Przejdź do treści</a>

		<header class="top">
			<div class="wrap top__row">
				<a class="brand" href={`${base}/`} aria-label={`${firma.nazwaPelna}, strona główna`}>
					<svg class="brand__mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
						<rect width="32" height="32"></rect>
						<path d="M6 12v12l10-6zM26 12v12l-10-6z"></path>
						<path d="M16 18V8M11 8h10" fill="none" stroke-width="2.5" stroke-linecap="square"></path>
					</svg>
					<span class="brand__name">
						{firma.nazwa}
						<small>{firma.wlasciciel}</small>
					</span>
				</a>

				<nav class="top__nav" aria-label="Główne menu">
					{menu.map((pozycja) => <a href={pozycja.href}>{pozycja.nazwa}</a>)}
				</nav>

				<button class="theme" type="button" data-theme-toggle aria-label="Włącz tryb ciemny" title="Włącz tryb ciemny" hidden>
					<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
						<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
						<path d="M12 3.500a8.500 8.500 0 0 1 0 17z" fill="currentColor"></path>
					</svg>
				</button>

				{
					firma.telefon ? (
						<a class="button button--small top__cta" href={telHref(firma.telefon)}>
							<span class="long">{firma.telefon}</span>
							<span class="short">Zadzwoń</span>
						</a>
					) : (
						<a class="button button--small top__cta" href={`${base}/#kontakt`}>
							<span class="long">Zapytaj o&nbsp;wycenę</span>
							<span class="short">Wycena</span>
						</a>
					)
				}
			</div>
		</header>

		<nav class="subnav" aria-label="Sekcje strony">
			<div class="wrap">
				{menu.map((pozycja) => <a href={pozycja.href}>{pozycja.nazwa}</a>)}
			</div>
		</nav>

		<main id="tresc">
			<slot />
		</main>

		<footer class="foot">
			<div class="wrap foot__row">
				<p>
					© {new Date().getFullYear()} {firma.nazwaPelna} · NIP {firma.nip}
				</p>
				<button class="theme theme--text" type="button" data-theme-toggle hidden>Włącz tryb ciemny</button>
				<p>
					Projekt i&nbsp;realizacja: <a href="https://solvy.pl" rel="noopener">Solvy.pl</a>
				</p>
			</div>
		</footer>

		<script is:inline>
			// Plays each entry animation once, when its element scrolls into view.
			(() => {
				window.revealReady = true;
				if (!document.documentElement.classList.contains('anim')) return;

				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (!entry.isIntersecting) continue;

							entry.target.dataset.reveal = 'run';
							observer.unobserve(entry.target);
						}
					},
					// Starts when the top of the element is a little way into the screen, however tall the element is.
					{ rootMargin: '0px 0px -12% 0px' },
				);

				document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));
			})();
		</script>

		<script is:inline>
			// The light/dark switch. The choice is remembered on this device; without JavaScript the buttons stay hidden and the page is light.
			(() => {
				const root = document.documentElement;
				const buttons = document.querySelectorAll('[data-theme-toggle]');
				const color = document.querySelector('meta[name="theme-color"]');

				const show = () => {
					const dark = root.dataset.theme === 'dark';
					const label = dark ? 'Włącz tryb jasny' : 'Włącz tryb ciemny';

					color.content = dark ? '#0c0c0d' : '#ffffff';
					for (const button of buttons) {
						button.hidden = false;
						if (button.hasAttribute('aria-label')) {
							button.setAttribute('aria-label', label);
							button.title = label;
						} else {
							button.textContent = label;
						}
					}
				};

				for (const button of buttons) {
					button.addEventListener('click', () => {
						const dark = root.dataset.theme !== 'dark';

						if (dark) root.dataset.theme = 'dark';
						else delete root.dataset.theme;

						try {
							localStorage.setItem('motyw', dark ? 'ciemny' : 'jasny');
						} catch {}
						show();
					});
				}

				show();
			})();
		</script>
	</body>
</html>
