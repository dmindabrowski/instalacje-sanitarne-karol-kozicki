---
// TYMCZASOWE: podgląd wariantów statystyk do wyboru. Usunąć po decyzji, przed publikacją.
import Layout from '../layouts/Layout.astro';
import liczby from '../data/liczby.json';

const warianty = [
	{ id: 'a', nazwa: 'A. Zdanie', opis: 'Bez ramek: jedno zdanie z wyróżnionymi liczbami.' },
	{ id: 'b', nazwa: 'B. Pasek', opis: 'Jeden wąski biały pasek, liczba i podpis w jednej linii.' },
	{ id: 'c', nazwa: 'C. Lewa kolumna', opis: 'Liczby pod opisem sekcji, obok zdjęć. Sekcja nie rośnie.' },
	{ id: 'd', nazwa: 'D. Znaczniki', opis: 'Liczba w małym czarnym polu, podpis obok, bez kafelka.' },
];
---

<Layout title="Warianty statystyk (podgląd roboczy)">
	{
		warianty.map((wariant) => (
			<>
				<div class="pick">
					<div class="wrap">
						<strong>{wariant.nazwa}</strong> <span>{wariant.opis}</span>
					</div>
				</div>
				<section class="section section--alt">
					<div class="wrap section__grid">
						<header class="section__head">
							<h2>Realizacje</h2>
							<p>Wybrane projekty i&nbsp;wykonane instalacje.</p>
							{wariant.id === 'c' && (
								<dl class="v-c">
									{liczby.map((liczba) => (
										<div>
											<dt>{liczba.opis}</dt>
											<dd>{liczba.wartosc}</dd>
										</div>
									))}
								</dl>
							)}
						</header>

						<div>
							{wariant.id === 'a' && (
								<p class="v-a">
									<b>100+</b> zrealizowanych zleceń, w&nbsp;tym <b>60+</b> projektów instalacji i&nbsp;<b>40+</b> wykonanych instalacji.
								</p>
							)}
							{wariant.id === 'b' && (
								<dl class="v-b">
									{liczby.map((liczba) => (
										<div>
											<dt>{liczba.opis}</dt>
											<dd>{liczba.wartosc}</dd>
										</div>
									))}
								</dl>
							)}
							{wariant.id === 'd' && (
								<dl class="v-d">
									{liczby.map((liczba) => (
										<div>
											<dt>{liczba.opis}</dt>
											<dd>{liczba.wartosc}</dd>
										</div>
									))}
								</dl>
							)}

							<ul class="works">
								{[1, 2, 3].map((nr) => (
									<li class="work work--blank">
										<span class="blank">
											<b>Fot. {nr}</b>
										</span>
										<div class="work__body">
											<i class="bar" />
											<i class="bar bar--short" />
										</div>
									</li>
								))}
							</ul>
						</div>
					</div>
				</section>
			</>
		))
	}
</Layout>

<style>
	.pick {
		padding-block: 0.6rem;
		border-top: 1px solid var(--ink);
		background: var(--bg);
		font-size: 0.95rem;
	}

	.pick span {
		color: var(--ink-2);
	}

	dl {
		margin: 0;
	}

	dd {
		margin: 0;
	}

	/* A. One sentence, numbers set larger and black */
	.v-a {
		max-width: 44rem;
		margin-bottom: 1.25rem;
		color: var(--ink-2);
		font-size: clamp(1.1rem, 1.9vw, 1.3rem);
		line-height: 1.5;
		text-wrap: balance;
	}

	.v-a b {
		color: var(--ink);
		font-size: 1.3em;
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	/* B. One narrow bar */
	.v-b {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-bottom: 1rem;
		border: 1px solid var(--ink);
		background: var(--bg);
	}

	.v-b div {
		display: flex;
		flex-direction: row-reverse;
		align-items: baseline;
		justify-content: flex-end;
		gap: 0.55rem;
		padding: 0.65rem 1rem;
	}

	.v-b div + div {
		border-left: 1px solid var(--line);
	}

	.v-b dd {
		font-size: 1.35rem;
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.v-b dt {
		color: var(--ink-2);
		font-size: 0.9rem;
	}

	/* C. A short list in the left column */
	.v-c {
		margin-top: 1rem;
		border-top: 1px solid var(--ink);
	}

	.v-c div {
		display: flex;
		flex-direction: row-reverse;
		align-items: baseline;
		justify-content: flex-end;
		gap: 0.6rem;
		padding: 0.45rem 0;
		border-bottom: 1px solid var(--line);
	}

	.v-c dd {
		flex: none;
		width: 3.4rem;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.v-c dt {
		color: var(--ink-2);
		font-size: 0.85rem;
		line-height: 1.3;
	}

	/* D. Number in a small black field, label beside it */
	.v-d {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 2rem;
		margin-bottom: 1.1rem;
	}

	.v-d div {
		display: flex;
		flex-direction: row-reverse;
		align-items: center;
		gap: 0.6rem;
	}

	.v-d dd {
		padding: 0.15rem 0.55rem;
		background: var(--ink);
		color: var(--bg);
		font-size: 1rem;
		font-weight: 600;
	}

	.v-d dt {
		font-size: 0.95rem;
		font-weight: 500;
	}

	@media (max-width: 48rem) {
		.v-b {
			grid-template-columns: minmax(0, 1fr);
		}

		.v-b div + div {
			border-top: 1px solid var(--line);
			border-left: 0;
		}

		.v-b dd,
		.v-c dd {
			flex: none;
			width: 4rem;
		}
	}
</style>
